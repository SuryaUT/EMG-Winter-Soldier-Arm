# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/
Bucky_Arm_venv/

# ─── PlatformIO / ESP-IDF ────────────────────────────────────────────────────
.pio/
EMG_Arm/.pio/
# Vendored ESP-IDF components (esp-dsp, esp-nn, esp-tflite-micro).
# See README "Vendored ESP-IDF components" for the clone commands.
EMG_Arm/components/
# sdkconfig is generated from sdkconfig.defaults on first build.
EMG_Arm/sdkconfig.esp32-*
!EMG_Arm/sdkconfig.defaults
*.old

# Firmware build artifacts
*.bin
*.elf
*.map

# ─── Editors / IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ─── Claude Code / Superpowers ───────────────────────────────────────────────
.claude/
.claudeignore
docs/superpowers/
**/superpowers/

# ─── Logs and captured serial dumps ──────────────────────────────────────────
*.log
dump*.txt
firmware_out*.txt
parity_*.csv
tools/*.txt

# ─── Data (large HDF5 recordings — collect your own, see README) ─────────────
collected_data/
extra_data/
assets/
*.hdf5
*.h5

# ─── Trained model binaries (regenerate via the training pipeline) ───────────
models/*.joblib
models/*.npz
models/*.tflite

# ─── Animations / rendered media ─────────────────────────────────────────────
animations/
media/
*.mp4
*.mov

# ─── Planning docs ───────────────────────────────────────────────────────────
BUCKY_ARM_MASTER_PLAN.md

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
